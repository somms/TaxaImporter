# WFO REST API (Guzzle TLS)
# Prefer an explicit CA bundle on Linux/WSL:
# TAXAIMPORTER_WFO_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Dev-only: disable TLS verification
# TAXAIMPORTER_WFO_INSECURE_SSL=0
# Retry once without TLS verify after an SSL error (default on; set 0 in production if desired)
# TAXAIMPORTER_WFO_SSL_FALLBACK=1

# Live PHPUnit (composer test:live)
# TAXAIMPORTER_LIVE_WFO=1
# TAXAIMPORTER_WFO_MAX_TAXA=100
